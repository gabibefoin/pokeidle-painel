# TLS, HTTP/2 e proxy para o jogo.
#
# O Caddy tira o certificado do Let's Encrypt sozinho na primeira subida e renova sozinho. Não
# há certbot, cron de renovação nem as quatro linhas de `Upgrade`/`Connection` que todo mundo
# erra uma vez ao pôr WebSocket atrás de nginx — o `reverse_proxy` do Caddy já faz o upgrade.

# Authenticated Origin Pulls — a origem só aceita TLS de quem apresenta o certificado de
# cliente do Cloudflare (desde 15/09/2026).
#
# PRÉ-REQUISITOS, nesta ordem, ou o site cai:
#   1. Cloudflare → SSL/TLS → Origin Server → Authenticated Origin Pulls → "Global" LIGADO;
#   2. `/etc/caddy/cloudflare-origin-pull-ca.pem` instalado (o `provisionar.sh` copia de
#      `infra/cloudflare-origin-pull-ca.pem`; CA público do Cloudflare, válido até 01/11/2029,
#      SHA-256 9A:1A:C2:B4:…:3E:25:A2:B9).
# Desligar a chave no painel com isto em vigor DERRUBA O SITE. Para desfazer aqui: tirar os dois
# `import origem_cloudflare` e `systemctl reload caddy`.
#
# Junto do firewall (`infra/firewall-cloudflare.sh`: 80/443 só para as faixas do Cloudflare),
# fecha a origem para quem não passa pelo Cloudflare — era por ali que o `CF-Connecting-IP`
# podia ser forjado. A renovação do Let's Encrypt não é afetada: é pelo http-01, na porta 80.
(origem_cloudflare) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
		}
	}
}

# O `www` manda para o domínio sem `www`, com 301.
#
# Precisa existir aqui, e não só no DNS: o `www` aponta para esta máquina, e um host que o
# Caddy não conhece não ganha certificado — `https://www.pokeidle.io` daria erro de TLS antes
# de qualquer redirecionamento. Declarando o host, ele tira certificado para os dois.
#
# E um jogo com login precisa de UM endereço canônico: sessão gravada em `www` e sessão
# gravada no apex são duas sessões diferentes para o navegador.
www.__DOMINIO__ {
	import origem_cloudflare
	redir https://__DOMINIO__{uri} permanent
}

__DOMINIO__ {
	import origem_cloudflare

	# NÃO ponha `header` de segurança aqui.
	#
	# HSTS, CSP, `X-Content-Type-Options`, `Referrer-Policy` e `Permissions-Policy` são postos
	# pelo JOGO, em `src/server/seguranca.mjs`. Duplicar aqui não reforça nada — manda o
	# cabeçalho duas vezes, e navegador que recebe duas CSPs aplica a INTERSEÇÃO das duas, o
	# que já quebrou site de gente que achou que estava somando proteção.
	#
	# A CSP tem de sair de lá de qualquer jeito: ela carrega um nonce que muda a cada resposta
	# e precisa bater com o HTML daquela mesma resposta. O Caddy não tem como saber o nonce.
	#
	# O que o Caddy continua fazendo pela segurança do transporte é o que ele já faz sozinho:
	# tira e renova o certificado, e redireciona 80 → 443. O HSTS do jogo só aparece quando o
	# pedido chegou por HTTPS, e quem conta isso é o `X-Forwarded-Proto` que este proxy põe.

	# Compressão do que o jogo NÃO comprime sozinho.
	#
	# O gateway já manda os assets em gzip com o resultado guardado em memória (ver
	# `gateway.mjs`), e o Caddy não recomprime o que já vem com `content-encoding`. Isto aqui
	# pega o resto: as respostas de `/auth/*`, o `/saude` e o HTML.
	encode zstd gzip

	# WebSocket e HTTP no mesmo lugar — o jogo serve os dois na porta 8080.
	reverse_proxy localhost:8080 {
		# Um jogador fica com a conexão aberta a tarde inteira. Sem isto o Caddy derruba o
		# socket no timeout padrão de leitura e o jogo reconecta em looping.
		flush_interval -1
		# Um `systemctl reload caddy` NÃO derruba os WebSockets abertos: eles continuam na
		# configuração antiga por até 24 h. Sem isto, todo reload desconectava o jogo inteiro de
		# uma vez (e todo mundo reconectava junto).
		stream_close_delay 24h
	}

	# NÃO sobrescreva o `X-Forwarded-For` aqui.
	#
	# O `reverse_proxy` do Caddy já ACRESCENTA o IP do peer ao cabeçalho:
	#
	#   · direto:          X-Forwarded-For: <jogador>
	#   · via Cloudflare:  X-Forwarded-For: <jogador>, <cloudflare>
	#
	# Um `header_up X-Forwarded-For {remote_host}` (que já esteve aqui) substituiria tudo pelo
	# peer imediato — atrás do Cloudflare, o mundo inteiro viraria um IP só e o limite de 12
	# tentativas de login por minuto passaria a valer para TODOS os jogadores somados.
	#
	# O que MUDOU foi a leitura do outro lado. Este comentário dizia que o `ipDe()` lia o
	# primeiro da lista "e acerta o jogador nos dois casos"; acertava o formato e errava a
	# confiança. Nenhum proxy do caminho APAGA o que o cliente mandou, então quem chega com um
	# `X-Forwarded-For: 1.2.3.4` inventado faz a lista virar `1.2.3.4, <jogador>, <cloudflare>`
	# — e o primeiro elemento passa a ser texto do atacante. Um cabeçalho diferente por
	# requisição dava um balde de rate limit novo a cada tentativa.
	#
	# Hoje quem decide é `src/server/ip-cliente.mjs`, e ele prefere o `CF-Connecting-IP` (que o
	# Cloudflare sobrescreve, logo o cliente não planta) e cai para o ÚLTIMO elemento do
	# `X-Forwarded-For`, que é o que este proxy acrescentou. Leia lá antes de mexer aqui.
	#
	# Desde 15/09/2026 o `CF-Connecting-IP` só vale quando esse último elemento é uma faixa do
	# Cloudflare, e a origem não aceita mais conexão de fora dele (firewall + o `client_auth`
	# lá em cima). Ver `ip-cliente.mjs` e `infra/firewall-cloudflare.sh`.

	# Log no JOURNAL, não em arquivo próprio.
	#
	# Um `output file` exige que o diretório exista e pertença ao usuário do Caddy — e quando
	# não pertence, o `systemctl reload` falha inteiro com "permission denied", derrubando a
	# configuração nova junto. O journal já está de pé, já rotaciona sozinho e é onde se lê o
	# resto da máquina (`journalctl -u caddy`). Um lugar a menos para dar errado.
	#
	# `ERROR` porque log de acesso de um jogo com WebSocket é enorme e não diz nada: uma linha
	# por conexão e mais nada até ela cair.
	log {
		level ERROR
	}
}
