# Um gateway de um conjunto de N — `pokeidle-gateway@0`, `@1`, … — atrás do Caddy.
#
# Existe porque um processo Node é um núcleo: medido em 14/09/2026, o gateway único gastava 57% de
# um núcleo com ~1.400 sockets, então ~1.600 conexões é o teto confortável de UM gateway. Com vários,
# o Caddy reparte as conexões (ver `configurar_caddy` em `infra/configurar-fase.sh`).
#
# A porta sai do número da instância: @0 → 8080 (a mesma do `deploy.sh` e do `diagnostico.sh`),
# @1 → 8081, … até @7 → 8087. Com um gateway só, continua valendo `pokeidle-gateway.service`.
#
# Instalado por `infra/configurar-fase.sh --gateways N` — não copie à mão: o script troca
# __USUARIO__, __DESTINO__ e o SHARD_COUNT, que TEM de ser o mesmo dos sims.
[Unit]
Description=Pokeidle.io — gateway %i (WebSocket + estático)
Documentation=https://github.com/pedrofasi/PokeIdle-io/blob/master/infra/FASES-ESCALA.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__DESTINO__/game
Environment=ROLE=gateway
Environment=SHARD_COUNT=2
Environment=PORT=808%i
# Glibc abre uma arena de malloc por thread, e o `permessage-deflate` usa o threadpool do zlib:
# em 14/09/2026 o gateway tinha 535 MB de RSS com 49 MB de heap JS. Duas arenas seguram isso.
Environment=MALLOC_ARENA_MAX=2
# Conexões do Postgres por processo. O gateway usa poucas (4 em produção em 15/09/2026, com 1.150
# sockets); com 6 gateways e 10 sims na mesma máquina, os 25 padrão de cada um passariam do
# `max_connections` do banco. Orçamento em `infra/FASES-ESCALA.md`.
Environment=PG_POOL_MAX=10
# Compressão do socket com contexto (−~80% de banda): ligue num gateway só para comparar,
#   systemctl edit pokeidle-gateway@0   →   [Service]  Environment=WS_DEFLATE_CONTEXTO=1
# e, aprovado, em todos pelo `.env` (WS_DEFLATE_CONTEXTO=1) — o `.env` vale por cima daqui.
EnvironmentFile=-__DESTINO__/game/.env
ExecStart=/usr/bin/node src/server/index.mjs
Restart=always
RestartSec=3
StartLimitBurst=0
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DESTINO__
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pokeidle-gateway-%i

[Install]
WantedBy=multi-user.target
