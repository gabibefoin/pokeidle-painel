[Unit]
Description=Pokeidle.io — gateway (WebSocket + estático)
Documentation=https://github.com/pedrofasi/PokeIdle-io/blob/master/infra/FASES-ESCALA.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__DESTINO__/game
Environment=ROLE=gateway
Environment=SHARD_COUNT=2
Environment=PORT=8080
# Glibc abre uma arena de malloc por thread, e o `permessage-deflate` usa o threadpool do zlib:
# em 14/09/2026 o gateway tinha 535 MB de RSS com 49 MB de heap JS. Duas arenas seguram isso.
Environment=MALLOC_ARENA_MAX=2
EnvironmentFile=-__DESTINO__/game/.env
ExecStart=/usr/bin/node src/server/index.mjs
Restart=always
RestartSec=3
StartLimitBurst=0
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DESTINO__
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pokeidle-gateway

[Install]
WantedBy=multi-user.target
