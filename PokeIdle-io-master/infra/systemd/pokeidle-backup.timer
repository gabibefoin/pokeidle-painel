[Unit]
Description=Pokeidle.io — dispara o backup do Postgres de hora em hora
Documentation=https://github.com/pedrofasi/PokeIdle-io/blob/master/infra/BACKUP.md

[Timer]
# Todo minuto 17 de cada hora. O 17 não é enfeite: o `:00` é onde mora quase todo cron do
# mundo (e o `logrotate`, e o `apt-daily`), e a hora cheia é também quando mais gente entra no
# jogo. Dezessete minutos depois a máquina está mais calma e o dump de 2 s passa sem disputar.
OnCalendar=*-*-* *:17:00
# Sem isto, uma VPS que ficou 6 h fora volta e simplesmente perde as 6 rodadas. Com isto, ela
# roda uma na volta e retoma o ritmo — a janela de 30 dias fica com um buraco de 6 h em vez de
# um buraco silencioso e a contagem de 720 se recompõe sozinha.
Persistent=true
# Até 3 min de folga aleatória. Duas VPS (ou uma VPS e o CI) subindo backup no mesmo segundo é
# o tipo de coincidência que só aparece quando dói.
RandomizedDelaySec=3min
AccuracySec=30s
Unit=pokeidle-backup.service

[Install]
WantedBy=timers.target
