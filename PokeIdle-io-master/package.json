{
  "name": "poke-idle-sprite-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Espelho local + visualizador dos sprites de looktype (.spr/.dat) publicados por poke.idleworld.online. Material de pesquisa.",
  "scripts": {
    "fetch": "node tools/fetch-poke-assets.mjs && node tools/fetch-world.mjs && node tools/fetch-effects.mjs && node tools/fetch-ui-icons.mjs && node tools/fetch-shop-icons.mjs && node tools/fetch-bosses.mjs && node tools/build-indexes.mjs && node tools/build-formulas.mjs",
    "walkgrids": "node tools/build-walkgrids.mjs",
    "auditar:spawns": "node tools/analisar-spawns.mjs",
    "espalhar:spawns": "node tools/espalhar-spawns.mjs",
    "fetch:sprites": "node tools/fetch-poke-assets.mjs",
    "fetch:world": "node tools/fetch-world.mjs",
    "fetch:effects": "node tools/fetch-effects.mjs",
    "fetch:ui": "node tools/fetch-ui-icons.mjs",
    "fetch:maps": "node tools/fetch-world.mjs --maps",
    "indexes": "node tools/build-indexes.mjs && node tools/build-formulas.mjs && node tools/build-walkgrids.mjs",
    "maps:png": "node tools/export-map-pngs.mjs",
    "start": "node server.mjs",
    "nomeador": "node tools/nomeador/servidor.mjs",
    "nomeador:stop": "node tools/nomeador/parar.mjs",
    "nomeador:build": "python tools/nomeador/construir.py",
    "nomeador:build:tudo": "python tools/nomeador/construir.py --tudo",
    "nomeador:verificar": "node tools/nomeador/verificar-tudo.mjs",
    "nomeador:verificar-indice": "node tools/nomeador/verificar-indice.mjs",
    "nomeador:verificar-pokedex": "node tools/nomeador/verificar-pokedex-lab.mjs",
    "nomeador:snapshot-pokedex": "node tools/nomeador/verificar-pokedex-lab.mjs --atualizar",
    "nomeador:varredura-shinys": "node tools/nomeador/varredura-shinys.mjs",
    "nomeador:publicar-shinys": "node tools/nomeador/publicar-shinys-jogo.mjs",
    "nomeador:reparar": "python tools/nomeador/reparar-indice.py",
    "nomeador:restaurar-baseline": "python tools/nomeador/restaurar-do-baseline.py",
    "nomeador:recuperar": "python tools/nomeador/recuperar-especie.py",
    "nomeador:reverter": "python tools/nomeador/reverter-desde.py",
    "publicar:sprites": "node tools/publicar-sprites-lab.mjs",
    "publicar:sprites-backup": "node tools/publicar-sprites-backup.mjs",
    "sync:sprites": "node tools/sincronizar-sprites-jogo.mjs",
    "auditar:sprites": "node tools/nomeador/auditoria-sprites.mjs",
    "auditar:shinys": "node tools/nomeador/auditar-shinys.mjs",
    "nomeador:importar-backup": "node tools/nomeador/importar-do-backup.mjs",
    "publicar:backup": "node tools/publicar-sprites-backup.mjs",
    "publicar:lab": "node tools/nomeador/publicar-jogo.mjs --lab",
    "publicar:jogo": "node tools/publicar-sprites-backup.mjs",
    "ataques:novos": "node tools/aplicar-ataques-novos.mjs",
    "cooldowns:novos": "node tools/aplicar-cooldowns-novos.mjs",
    "golpes:especiais": "node tools/injetar-golpes-especiais.mjs",
    "mapas:sortear": "node tools/sortear-mapas-por-tipo.mjs",
    "aplicar-escala-hunt": "node tools/aplicar-escala-hunt-level.mjs",
    "marker-atlas": "python tools/build-marker-atlas.py"
  },
  "engines": {
    "node": ">=18"
  }
}
