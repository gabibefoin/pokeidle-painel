# Copie para .env se quiser mudar algo — os defaults já batem com o docker-compose.
PORT=8080
ROLE=all                 # all | gateway | sim
SHARD_ID=0               # índice deste worker de simulação
SHARD_COUNT=1            # total de workers de simulação (precisa ser igual em todos)

DATABASE_URL=postgres://poke:poke@localhost:5433/pokeidle
REDIS_URL=redis://localhost:6380

TICK_MS=250              # passo da simulação de combate
FLUSH_MS=5000            # intervalo do write-behind para o Postgres
ASSETS_DIR=../public/data

# ------------------------------------------------------------------- ORBs
#
# ORB é a moeda com lastro em USDT: entra por depósito, sai por saque, e no meio é só uma
# linha de banco. Não há NFT nem token nosso — só as duas pontes com a blockchain.

# A SEED MESTRA dos endereços de depósito (32 bytes em hex).
#
# Com ela, cada jogador ganha um endereço EXCLUSIVO e o memo deixa de existir — some a
# classe inteira de erro "mandou sem o código". Gere com `npm run orbs:seed`.
#
# Vazia = modo antigo: uma carteira só + memo. Funciona, mas o suporte sofre.
#
# É um segredo SEPARADO da chave da tesouraria, de propósito: quem vazar esta alcança só o
# que ainda não foi varrido. Perder a seed perde esse dinheiro — não há segunda via.
ORB_SEED_DEPOSITOS=
# Pausa entre endereços na varredura diária (ms). 120 ≈ 8 req/s — margem no limite de 10/s.
# ORBS_VARREDURA_PAUSA_MS=120

# Endereço PÚBLICO da carteira do projeto. É para cá que os jogadores mandam USDT, é daqui
# que saem os saques, e ele aparece na tela para qualquer um auditar. Vazio = a tela avisa
# que o depósito não está configurado, em vez de mostrar um endereço inventado.
CARTEIRA_PROJETO=
CARTEIRA_REDE=solana     # solana | bsc | polygon

# Liga o worker que ASSINA e envia os saques, E o watcher que lê os depósitos. Só UM
# processo do cluster pode ligá-lo — dois workers assinando o mesmo saque é a forma mais
# fácil de pagar duas vezes. (Existe uma trava de posse no Redis por cima disto, mas não
# conte com ela como único guarda.)
ORBS_WORKER=0

# A rede de verdade. Vazio = adaptador SIMULADO (nada sai da máquina), que é o que os testes
# usam e o único modo em que o watcher de depósitos NÃO sobe (não há o que varrer).
# Preencher isto liga dinheiro real: leia o cabeçalho de src/server/chain.mjs antes.
#
# Comece pela DEVNET. Ela é idêntica em API, o SOL é de graça (`solana airdrop 2`) e não
# existe USDT oficial lá — crie um SPL token seu de 6 casas para fazer o papel dele e ponha
# o mint em CHAIN_USDT_CONTRATO. O código lê os decimais do contrato, então funciona igual.
CHAIN_REDE=                                          # vazio | solana
CHAIN_RPC_URL=https://api.devnet.solana.com          # mainnet: use um RPC pago, não o público
# O mint do USDT. CONFIRA no explorer antes de ligar a mainnet: um mint errado manda o
# dinheiro dos jogadores para um token que não vale nada, e não volta.
CHAIN_USDT_CONTRATO=

# A CHAVE PRIVADA da carteira do projeto.
#
# NUNCA comite este valor. O .env está no .gitignore justamente por causa desta linha.
# Em produção, isto deveria vir de um gerenciador de segredos — ou, melhor, de um serviço de
# assinatura separado, para que o processo do jogo (o mais exposto do sistema) nunca tenha a
# chave em memória.
#
# Aceita os dois formatos: o array JSON de 64 bytes que `solana-keygen new --outfile` grava,
# ou a base58 que carteiras de navegador exportam.
#
# Só o processo com ORBS_WORKER=1 precisa dela. Gateway e sim leem a blockchain sem chave
# nenhuma — é por isso que as libs de assinatura são importadas lá dentro de `enviar`.
CARTEIRA_CHAVE_PRIVADA=

# ------------------------------------------------------------------ contas
#
# O jogo entra com conta registrada: senha própria ou provedor externo (Google/Discord).
# Sem sessão assinada de uma conta real, o WebSocket recusa o `hello`. Tudo abaixo é OPCIONAL —
# sem nada preenchido, contas com senha funcionam e os botões de provedor simplesmente não
# aparecem na tela de login.

# Segredo que assina o token de sessão. OBRIGATÓRIO em produção: sem ele, o servidor gera um
# segredo efêmero no boot (as sessões caem a cada restart) e loga um aviso.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SEGREDO=

# O endereço PÚBLICO do jogo. É com ele que se monta o `redirect_uri` do OAuth, e ele precisa
# bater CARACTERE A CARACTERE com o que estiver cadastrado no console do Google e do Discord —
# divergir aqui é o erro nº 1 de OAuth ("redirect_uri_mismatch").
URL_PUBLICA=http://localhost:8080

# --- Google ---
# console.cloud.google.com → APIs e Serviços → Credenciais → ID do cliente OAuth (app da Web).
# Em "URIs de redirecionamento autorizados", ponha exatamente:
#   <URL_PUBLICA>/auth/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord ---
# discord.com/developers/applications → sua app → OAuth2 → Redirects:
#   <URL_PUBLICA>/auth/discord/retorno
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Bot de CONVITES do Discord (processo separado: `npm run bot`) ---
# Conta quem entra no nosso servidor e por qual link, escreve no canal de log e manda no
# privado o codigo do marco. Quem ENTREGA o premio e o jogo, no `/resgatar <codigo>` do chat.
# Ver `src/bot/index.mjs` e `src/shared/convites.mjs`.
#
# Duas coisas precisam estar ligadas no painel do Discord, e sem elas o bot nao funciona:
#   1. Developer Portal -> Bot -> Privileged Gateway Intents -> SERVER MEMBERS INTENT
#      (sem ele o Discord recusa a conexao com close 4014)
#   2. o bot precisa da permissao GERENCIAR SERVIDOR (MANAGE_GUILD) no servidor
#      (sem ela `GET /guilds/{id}/invites` volta 403 e nao ha como atribuir o convite)
#
# `DISCORD_BOT_TOKEN` e o token do BOT (Developer Portal -> Bot -> Reset Token), e nao o
# client secret do OAuth acima -- sao credenciais diferentes da mesma aplicacao.
# Os dois ids saem do proprio Discord com o Modo Desenvolvedor ligado (Configuracoes ->
# Avancado), clicando com o botao direito no servidor e no canal -> Copiar ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CANAL_CONVITES=
#
# DISCORD_CANAL_RESGATE: o canal do BOTAO "Pegar meu codigo". Opcional, mas e' o caminho que
# funciona para todo mundo -- o privado falha para quem tem DM fechada (erro 50278), e o codigo
# nao pode ser postado num canal aberto porque vale em qualquer conta.
#
# O bot publica ali uma mensagem fixa com um botao, e a resposta ao clique e' EFEMERA: so quem
# clicou enxerga. E a unica forma que o Discord da de mostrar algo a uma pessoa so dentro de um
# canal publico -- `flags: EPHEMERAL` so vale como resposta a uma interacao.
DISCORD_CANAL_RESGATE=
#
# DISCORD_BOT_SO_CONTAR=1 faz o bot contar, atribuir e anunciar no canal SEM gerar nem mandar
# codigo. E para a janela em que o bot ja esta de pe e o jogo ainda nao tem o `/resgatar`: sem
# ela, quem cruzasse um marco nesse vao receberia um codigo que o cliente antigo nao sabe
# resgatar -- e o `/resgatar` viraria mensagem publica no chat.
#
# Tire a variavel (ou ponha 0) e reinicie o bot depois que o jogo subir. Nada se perde: os
# marcos sao recalculados na entrada seguinte daquele padrinho.
# DISCORD_BOT_SO_CONTAR=1
#
# --- OS RADARES (src/bot/radar.mjs) ---
#
# O mesmo processo do bot le o banco do jogo e conta no Discord o que acabou de acontecer:
# captura de shiny, saque aprovado, deposito confirmado e -- no canal da staff, mencionando o
# cargo -- pedido de saque.
#
# Os quatro ids abaixo tem PADRAO no codigo (sao os do nosso servidor, e id de canal nao e
# segredo): sem nada aqui, o radar ja sobe apontando para os canais certos. Estas variaveis
# servem para apontar para OUTRO canal -- ou, com o valor VAZIO, para desligar aquele radar.
# DISCORD_CANAL_RADAR_SHINY=1551768376362405919
# DISCORD_CANAL_RADAR_GEMAS=1551768812376825867
# DISCORD_CANAL_SAQUE_STAFF=1538695060529610812
# DISCORD_CARGO_SAQUE_STAFF=1545485031701610497
#
# De quanto em quanto tempo o bot pergunta ao banco se aconteceu algo novo. O piso e 2 s.
# RADAR_MS=10000
#
# O bot precisa de VER CANAL e ENVIAR MENSAGENS nos tres canais -- sao permissoes diferentes, e
# um canal de avisos costuma negar a segunda. Ele confere as duas no boot e escreve no log
# exatamente qual falta. No canal da staff ele precisa TAMBEM de "Mencionar @everyone, @here e
# todos os cargos" se o cargo do saque nao for mencionavel por padrao.

# --- Cloudflare Turnstile (captcha em /auth/entrar e /auth/criar) ---
# dash.cloudflare.com → Turnstile → Add widget. Domínios: pokeidle.io, www.pokeidle.io e
# localhost (dá pra por os três no MESMO widget — a mesma chave serve dev e produção).
# Modo recomendado: Managed.
# Sem as chaves, o captcha nem aparece na tela e o login funciona como hoje.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend (confirmação de e-mail e, no futuro, redefinição de senha) ---
# resend.com → API Keys. O domínio do remetente precisa estar verificado lá (DNS: SPF+DKIM),
# senão o e-mail sai para spam ou nem sai.
# Sem a chave, criar conta funciona igual e o e-mail simplesmente não é enviado — o jogo não
# trava esperando um serviço que ainda não foi contratado.
RESEND_API_KEY=
RESEND_DE=Pokéidle <nao-responda@seudominio.com>

# ----------------------------------------------- compra de DIAMANTES (dinheiro de verdade)
#
# Diamante é a moeda da Loja: entra por PIX ou cartão e é gasta em boost, VIP, outfit e bolas.
# Não confundir com a GEMA, que é a moeda com lastro em USDT do Mercado da Comunidade (as
# variáveis dela são as de CHAIN_* / CARTEIRA_* lá em cima).
#
# As duas integrações são INDEPENDENTES: dá para subir com só uma configurada, e a tela
# esconde o botão da que faltar. Sem nenhuma das duas, a compra some da Loja e o resto do
# jogo segue igual — é o estado padrão em dev.
#
# Os webhooks precisam alcançar este servidor de fora. Em dev, use um túnel (cloudflared,
# ngrok) e aponte a URL do provedor para:
#   <URL_PUBLICA>/webhooks/stripe
#   <URL_PUBLICA>/webhooks/efi/<EFI_WEBHOOK_SEGREDO>
#
# Mesmo que o webhook se perca, o crédito acontece: o gateway reconsulta os pendentes a cada
# minuto (`reconciliarPendentes`). O webhook só torna a entrega mais rápida.

# --- Stripe (CARTÃO) ---
# dashboard.stripe.com → Developers → API keys. Use a chave `sk_test_...` para testar.
STRIPE_SECRET_KEY=
# Developers → Webhooks → adicione o endpoint acima e escute `checkout.session.completed`.
# SEM esta variável o webhook é RECUSADO — é ela que prova que o pedido veio do Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Efí (PIX) ---
# sejaefi.com.br → área de desenvolvedores → crie uma aplicação Pix e baixe o CERTIFICADO (.p12)
# dela. Ao contrário do Stripe/LivePix, a API da Efí exige esse certificado em TODA chamada
# (é a identidade do cliente na conexão, por cima do client_id/secret) — sem ele nada funciona,
# nem a troca do token.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Caminho do arquivo .p12 baixado no painel. NUNCA comite este arquivo — ele é tão sensível
# quanto a chave privada da carteira lá em cima. Guarde fora do controle de versão.
EFI_CERTIFICADO=
# Só preencha se o .p12 tiver sido gerado com senha (o padrão da Efí não tem).
EFI_CERTIFICADO_SENHA=
# A chave Pix cadastrada na conta Efí que vai RECEBER o dinheiro (CNPJ, e-mail, telefone ou
# aleatória — a que estiver ativa na conta).
EFI_CHAVE_PIX=
# OBRIGATÓRIA — diferente do LivePix, a Efí não manda identificador nenhum no corpo do webhook
# (só a chave Pix, que é informação pública). Sem este segredo no caminho da URL, qualquer POST
# seria aceito como gatilho; é por isso que aqui não existe modo "opcional" como no LivePix.
EFI_WEBHOOK_SEGREDO=
#
# O cadastro da URL do webhook na Efí não tem campo no painel — é uma chamada de API. Depois de
# preencher as variáveis acima, rode UMA VEZ (ou de novo se URL_PUBLICA mudar):
#   node tools/efi-configurar-webhook.mjs

# ------------------------------------------------------- VOTE & GANHE (TopIdle)
#
# O jogador vota em topidle.com, autenticado pela conta Google DELES, e o TopIdle avisa este
# servidor por webhook. A cada 2 votos sai 1 diamante, e entre dois votos que CONTAM tem de
# passar 24 h — ou seja, o teto de emissão é 1 diamante a cada DOIS dias por jogador.
# Ver `src/server/game/topidle.mjs`.
#
# MEDIDO EM PRODUÇÃO (13/08/2026): o evento deles NÃO traz identidade nenhuma da conta que
# votou — só `eventId`, `gameId`, `playerIdentifier`, `type` e `votedAt`. Com isso o vínculo
# conta-do-TopIdle ↔ jogador (`MAX_VOTANTES_POR_JOGADOR`) não roda.
#
# E o TopIdle NÃO barra multi-conta: dá para logar com outro Gmail, votar no mesmo nick e o
# evento chega igualzinho, segundos depois. Reproduzido — duas contas rendiam um diamante na
# hora. Quem fecha isso é a RECARGA POR JOGADOR: todo voto que conta grava em
# `topidle_votos.proximo_em` a partir de quando o próximo daquele nick pode contar, e o que
# chegar antes entra gravado com `motivo_zero = 'recarga'` e não soma.
#
# É janela DESLIZANTE, e não teto por dia, de propósito: com recorte de calendário, 23h50 e
# 00h10 são dias diferentes e passariam os dois, vinte minutos depois um do outro.
#
# Se um dia eles passarem a mandar `voterId` ou o e-mail, é só acrescentar o nome do campo em
# `chaveVotante` e o vínculo volta a valer sozinho. O log avisa `vínculo de conta DESLIGADO`
# uma vez por processo, com a lista dos campos que chegaram.
#
# NÃO ESQUEÇA de marcar "Recompensas ativas" no painel deles. Sem isso a integração fica
# inativa: a caixinha do identificador não aparece para o jogador, o webhook nunca sai, e a
# API responde 401 "Chave da integração inválida ou inativa".
#
# Passo a passo no painel deles (https://topidle.com → Integração para desenvolvedores):
#   1. Reivindique o jogo com a conta Google responsável e verifique o domínio pokeidle.io.
#   2. Cadastre o webhook:  <URL_PUBLICA>/webhooks/topidle
#   3. Deixe as recompensas DESLIGADAS lá (quem paga é este servidor) e gere as credenciais.
#   4. Copie a chave e o segredo — eles aparecem UMA vez só — e preencha abaixo.
#   5. Clique em "Enviar teste": deve sair um `[topidle]` no log deste processo.
#
# Em "Identificador solicitado ao jogador", escreva o RÓTULO do campo: `Nome do personagem`.
# É o nick, e é ele que o nosso link de voto já preenche. Deixar em branco faria o TopIdle
# mandar o e-mail Google — que aqui só funciona para quem entrou com Google.

# O id do jogo, o que aparece na URL pública de votação.
TOPIDLE_JOGO_ID=pokeidle-io-5f9969

# O segredo que assina o webhook. SEM ele o endpoint devolve 503 e nada é creditado — um
# endereço que aceita qualquer POST enquanto o segredo não chegou é uma torneira de diamante.
TOPIDLE_WEBHOOK_SECRET=

# A chave da API, usada só pela REDE DE SEGURANÇA: se o webhook se perder (deploy no meio,
# DNS, 500 nosso), o gateway relê `GET /api/v1/votes?after=<cursor>` de cinco em cinco
# minutos e credita o que ficou para trás. Vazia = só o webhook.
TOPIDLE_API_KEY=
# Só para apontar para um ambiente de teste deles. Vazio = https://topidle.com
TOPIDLE_API_URL=

# ------------------------------------------------------------- bancada de teste do shiny
#
# Com isto ligado (o padrão), METADE dos encontros na hunt do Oddish sai shiny — é o que
# torna possível conferir o caminho spawn → arte brilhante → captura → sprite em campo sem
# esperar 1/16.000. Nenhuma outra hunt e nenhuma outra espécie mudam.
#
# DESLIGUE ANTES DE ABRIR AO PÚBLICO: 50% numa hunt de nível 1 é uma fábrica de shiny.
SHINY_TESTE=1

# Outfits beta grátis na loja (Shop → Outfits). Padrão = abertas. Após o reset, use 0.
# BETA_OUTFITS_ABERTAS=0

# ---------------------------------------------------- Caixas de Fundador (Shop → Caixas)
#
# QUANDO a venda das caixas abre. Antes disso a vitrine mostra as duas caixas com o conteúdo
# à mostra e uma contagem regressiva no lugar do preço — a compra é recusada pelo servidor,
# não só escondida pela tela.
#
# Padrão: 7 de setembro de 2026, 00h de Brasília (`2026-09-07T03:00:00Z`, ver
# `shared/caixas-beta.mjs`). Aceita ISO ou carimbo em ms. Para testar a venda ABERTA sem
# esperar, ponha uma data no passado.
#
# O ESTOQUE (50 Fundador, 100 CoFundador) não é configurável: ele é o produto, e mudá-lo
# depois de vender a primeira quebraria a promessa do número. Mora no código.
# CAIXAS_BETA_ABREM=2026-09-07T03:00:00Z

# ------------------------------------------------------------------ painel de lucro
#
# Quem enxerga `/admin` e pode transferir a sobra da tesouraria. VAZIO = o painel não existe:
# `/admin/*` devolve 404 para todo mundo, inclusive para você. É o padrão de propósito.
ADMIN_EMAILS=

# Quem resolve auditoria: vê as abas Auditoria + Resolver Auditoria (entregar itens/diamantes).
# E-mails aqui entram no painel restrito — a menos que também estejam em ADMIN_EMAILS.
# VAZIO = essas abas não existem para ninguém fora do admin completo.
AUDITORIA_RESOLVER_EMAILS=

# Documentos para MED (aba do painel): quem pode gerar o relatório de auditoria de uma conta,
# que contém CPF, e-mail e IP. VAZIO = todo e-mail de ADMIN_EMAILS. Preenchido = só estes — e
# eles ainda precisam estar em ADMIN_EMAILS. A Resolver Auditoria nunca tem acesso.
MED_EMAILS=

# Dados da empresa no cabeçalho do documento de MED. Nada é inventado: campo vazio sai no
# documento como "Não disponível nos registros do sistema". Sem EMPRESA_CNPJ vale o CNPJ do
# prestador das notas fiscais; sem EMPRESA_SITE, https://pokeidle.io; sem EMPRESA_EMAIL, o
# contato dos Termos (support@pokeidle.io). Não ponha comentário na mesma linha do valor.
EMPRESA_RAZAO_SOCIAL=
EMPRESA_NOME_FANTASIA=
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_EMAIL=
EMPRESA_SITE=

# As carteiras que podem RECEBER, no formato `nome:endereco,nome:endereco`.
#
# É uma lista fechada, e não um campo livre na tela, porque é a trava que transforma "roubaram
# minha sessão do Google e levaram o caixa" em "moveram meu dinheiro para a minha própria
# carteira fria". Mudar esta lista exige acesso a este arquivo — ou seja, SSH.
CARTEIRAS_LUCRO=

# Quantas vezes o passivo tem de caber no caixa antes de sobrar alguma coisa.
#
# 1,5 quer dizer: só é "sobra" o que passar de uma vez e meia tudo que os jogadores poderiam
# sacar hoje. O custo de deixar dinheiro parado é zero; o de não conseguir pagar um saque é a
# confiança no jogo inteiro.
COLCHAO_LUCRO=1.5

# ------------------------------------------------------- Criptografia de dados
#
# O banco está preso ao loopback e o firewall só abre 22/80/443 — pela rede ninguém chega
# nele. O que sai da máquina é o BACKUP, e é ele que carrega o CPF de quem comprou diamante.
# Estas duas variáveis fecham esse caminho. Ver `src/server/cofre.mjs`.

# Cifra o CPF dos compradores no banco (AES-256-GCM). 32 bytes em hex.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sem ela o jogo SOBE do mesmo jeito e grava em texto puro, avisando no log — derrubar o jogo
# inteiro por causa de uma coluna seria pior. Em produção o aviso é erro.
#
# PERDER a chave torna ilegíveis os CPFs já gravados (o resto do banco fica intacto). Ela não
# é derivável de nada: guarde junto do AUTH_SEGREDO.
#
# Linhas gravadas ANTES de existir chave continuam em texto puro e continuam sendo lidas —
# elas se convertem sozinhas na próxima gravação. Não há migração para rodar.
DADOS_CHAVE=

# --------------------------------------------------------------- desenvolvimento
# Tira a espera de 10 min entre revanches do PvP ranqueado (`REVANCHE_MS`), para dar
# para testar o modo com duas contas sem esperar dez minutos por partida.
#
# SÓ vale com NODE_ENV=development (guarda positiva) — ver `pvpSemRevanche` em
# src/server/config.mjs. Produção não define NODE_ENV, e por isso a guarda não pode ser
# escrita como "diferente de production".
# O peso de revanche (a partida repetida rende metade, depois um quarto, depois nada)
# continua valendo dos dois jeitos: isto tira a ESPERA, não a punição por repetir.
PVP_SEM_REVANCHE=
